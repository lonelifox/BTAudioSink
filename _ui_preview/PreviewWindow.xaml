<Window x:Class="Preview.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:BTAudioSink.Behaviors"
        Width="384" Height="330" SizeToContent="Manual"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Left="-2000" Top="0"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Light.xaml" />
                <ResourceDictionary Source="Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 内容层：跟主工程一样，淡入淡出只作用在这一层 -->
            <Grid x:Name="ContentLayer" Grid.RowSpan="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <!-- 头部（跟主工程 MainWindow.xaml 保持一致） -->
            <Grid Margin="14,12,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Source="../Assets/logo.png" Width="18" Height="18"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Text="BTAudioSink" Margin="8,0,0,0"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                <TextBlock Grid.Column="2" x:Name="BadgeText" Text="{DynamicResource Ui.Badge.None}"
                           Margin="7,0,0,0" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}" />

                <Button Grid.Column="4" x:Name="RefreshButton" Style="{StaticResource IconButton}"
                        Content="&#xE72C;" Width="26" Height="26" />
            </Grid>

            <ListBox x:Name="DeviceList" Grid.Row="1" Margin="14,10,8,0"
                     Background="Transparent" BorderThickness="0"
                     FocusVisualStyle="{x:Null}"
                     ItemContainerStyle="{StaticResource DeviceListItem}"
                     b:RowClickToggle.CollapseSelectedOnClick="True"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.Resources>
                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource OverlayScrollViewer}" />
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Ellipse Grid.RowSpan="2" Width="7" Height="7" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,4,0"
                                       Tag="Name"
                                       FontSize="12.5" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding StatusText}"
                                       Tag="Status"
                                       Margin="10,2,4,0" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Column="2" Grid.RowSpan="2"
                                        Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource DeviceToggleChip}"
                                          Content="{DynamicResource Ui.Device.Auto}"
                                          IsChecked="{Binding IsAutoReconnect, Mode=TwoWay}" />
                                <Button Content="{DynamicResource Ui.Device.Reconnect}"
                                        Style="{StaticResource DeviceSecondaryChip}"
                                        Margin="6,0,0,0" />
                                <Button Content="{Binding ActionText}"
                                        Tag="Action"
                                        Style="{StaticResource DeviceActionButton}"
                                        Margin="6,0,0,0" />
                            </StackPanel>

                            <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,9,0,0" Padding="0,9,0,0"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                    ClipToBounds="True" Visibility="Collapsed"
                                    b:RevealBehavior.IsRevealed="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                                        <TextBlock Text="{DynamicResource Ui.Detail.Address}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBlock Text="{Binding AddressText}" FontSize="11" Margin="0,2,0,0"
                                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource Ui.Detail.Link}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBlock Text="{Binding LinkText}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{DynamicResource Ui.Detail.Rssi}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBlock Text="{Binding RssiText}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Ui.Detail.Type}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBlock Text="{Binding DeviceTypeText}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 底栏 -->
            <Border x:Name="FooterBar" Grid.Row="2" Margin="14,8,14,12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="0,8,0,0">
                <Grid Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="LastLogText" Text="{DynamicResource Ui.Log.Ready}" FontSize="10.5"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               TextWrapping="Wrap"
                               LineHeight="15" LineStackingStrategy="BlockLineHeight"
                               MaxHeight="30"
                               TextTrimming="CharacterEllipsis" />

                    <Button x:Name="LogButton" Grid.Column="1"
                            Style="{StaticResource DeviceSecondaryChip}"
                            Content="{DynamicResource Ui.Log.Button}" Height="24" Padding="9,0" FontSize="10.5" />
                </Grid>
            </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
