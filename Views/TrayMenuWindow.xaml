<Window x:Class="BTAudioSink.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- 外面这圈 Margin 是留给阴影的，不然会被窗口边界裁掉 -->
    <Border Margin="12" Width="256" CornerRadius="10"
            Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.26" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="6">

            <Button Style="{StaticResource TrayMenuItem}" Click="OnOpenClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Width="24" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{DynamicResource Tray.Open}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button x:Name="DisconnectAllItem" Style="{StaticResource TrayMenuItem}"
                    Click="OnDisconnectAllClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Width="24" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{DynamicResource Tray.DisconnectAll}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border Height="1" Margin="6,5" Background="{DynamicResource BorderBrush}" />

            <!-- 外观三档：跟主界面里的分段选择器同一套样式 -->
            <Grid Margin="10,2,6,2" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{DynamicResource Tray.Appearance}" FontSize="12.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <Border Grid.Column="1" CornerRadius="6" Padding="2" VerticalAlignment="Center"
                        Background="{DynamicResource SegmentTrackBrush}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeAuto" Content="{DynamicResource Tray.Theme.Auto}" Tag="Auto"
                                     Style="{StaticResource SegmentRadio}"
                                     FontSize="11" Padding="8,2"
                                     Checked="OnThemeChecked" />
                        <RadioButton x:Name="ThemeLight" Content="{DynamicResource Tray.Theme.Light}" Tag="Light"
                                     Style="{StaticResource SegmentRadio}"
                                     FontSize="11" Padding="8,2"
                                     Checked="OnThemeChecked" />
                        <RadioButton x:Name="ThemeDark" Content="{DynamicResource Tray.Theme.Dark}" Tag="Dark"
                                     Style="{StaticResource SegmentRadio}"
                                     FontSize="11" Padding="8,2"
                                     Checked="OnThemeChecked" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="10,2,8,2" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{DynamicResource Tray.Mica}" FontSize="12.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <CheckBox x:Name="MicaToggle" Grid.Column="1" Content=""
                          Style="{StaticResource ToggleSwitch}"
                          VerticalAlignment="Center"
                          Checked="OnMicaChanged" Unchecked="OnMicaChanged" />
            </Grid>

            <Grid Margin="10,2,8,2" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{DynamicResource Tray.Startup}" FontSize="12.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <CheckBox x:Name="StartupToggle" Grid.Column="1" Content=""
                          Style="{StaticResource ToggleSwitch}"
                          VerticalAlignment="Center"
                          Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
            </Grid>

            <!-- 语言：跟外观一样用分段选择器，切换后整个界面立刻换文案 -->
            <Grid Margin="10,2,6,2" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{DynamicResource Tray.Language}" FontSize="12.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />

                <Border Grid.Column="1" CornerRadius="6" Padding="2" VerticalAlignment="Center"
                        Background="{DynamicResource SegmentTrackBrush}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LanguageChinese" Content="{DynamicResource Tray.Language.Zh}"
                                     Tag="Chinese"
                                     Style="{StaticResource SegmentRadio}"
                                     FontSize="11" Padding="8,2"
                                     Checked="OnLanguageChecked" />
                        <RadioButton x:Name="LanguageEnglish" Content="{DynamicResource Tray.Language.En}"
                                     Tag="English"
                                     Style="{StaticResource SegmentRadio}"
                                     FontSize="11" Padding="8,2"
                                     Checked="OnLanguageChecked" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Height="1" Margin="6,5" Background="{DynamicResource BorderBrush}" />

            <Button Style="{StaticResource TrayMenuDangerItem}" Click="OnExitClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Width="24" VerticalAlignment="Center"
                               Foreground="{DynamicResource DangerBrush}" />
                    <TextBlock Text="{DynamicResource Tray.Exit}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
